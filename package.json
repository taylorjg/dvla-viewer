{
  "name": "dvla-viewer",
  "description": "Simple app to lookup car registrations using DVLA API",
  "private": true,
  "version": "0.0.23",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "open": "open https://taylorjg.github.io/dvla-viewer",
    "test": "vitest run",
    "test:cypress": "cypress run --e2e --browser chrome",
    "test:cypress:open": "cypress open --e2e --browser chrome",
    "a11y:report": "bash scripts/a11y-report.sh"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.1.2",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.18.1",
    "change-case": "^5.4.2",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/cypress": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.2.7",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.5",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lighthouse": "^13.5.0",
    "msw": "^2.12.10",
    "prettier": "^3.9.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "msw@2.15.0": true,
    "cypress@15.21.1": true
  }
}
